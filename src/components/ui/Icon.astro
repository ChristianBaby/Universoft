---
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = "" } = Astro.props;

const icons = import.meta.glob("../../../node_modules/lucide-static/icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;

const key = Object.keys(icons).find((path) => path.endsWith(`/${name}.svg`));
const svg = key ? icons[key] : "";
---

<span
  class={`inline-flex shrink-0 ${className}`}
  style={`width:${size}px;height:${size}px`}
  aria-hidden="true"
  set:html={svg.replace("<svg", `<svg width="${size}" height="${size}"`)}
/>
