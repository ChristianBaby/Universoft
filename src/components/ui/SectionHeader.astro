---
interface Props {
  label?: string;
  title: string;
  description?: string;
  centered?: boolean;
  as?: "h1" | "h2";
  tone?: "light" | "dark";
}

const { label, title, description, centered = true, as: Heading = "h2", tone = "light" } = Astro.props;

const isDark = tone === "dark";
const align = centered ? "text-center items-center" : "text-left items-start";
const titleColor = isDark ? "text-white" : "text-navy";
const labelColor = isDark ? "text-blue-bright" : "text-blue";
const descColor = isDark ? "text-white/70" : "text-navy/60";
---

<header class={`reveal flex flex-col gap-4 ${align}`}>
  {label && (
    <div class={`flex flex-col gap-2 ${centered ? "items-center" : "items-start"}`}>
      <span class={`text-xs font-semibold uppercase tracking-widest ${labelColor}`}>{label}</span>
      <div class="h-0.5 w-10 rounded-full bg-gradient-to-r from-blue to-blue-bright" />
    </div>
  )}
  <Heading class={`font-display text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl ${titleColor}`}>
    {title}
  </Heading>
  {description && (
    <p class={`max-w-2xl text-base leading-relaxed lg:text-lg ${descColor}`}>{description}</p>
  )}
</header>
