---
interface Props {
  color?: "blue" | "blue-bright" | "navy";
  size?: "sm" | "md" | "lg";
  class?: string;
}

const { color = "blue", size = "md", class: className = "" } = Astro.props;

const sizes = { sm: "w-48 h-48", md: "w-80 h-80", lg: "w-[500px] h-[500px]" };
const colors = { blue: "bg-blue/15", "blue-bright": "bg-blue-bright/15", navy: "bg-navy/20" };
---

<div
  class={`pointer-events-none absolute rounded-full blur-[100px] select-none ${sizes[size]} ${colors[color]} ${className}`}
  aria-hidden="true"
></div>
