---
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import ParticlesCanvas from "@/components/particles/ParticlesCanvas";
---

<section class="relative flex min-h-[90vh] items-center overflow-hidden bg-white pt-24">
  <div class="absolute inset-0" aria-hidden="true">
    <div class="absolute -right-32 top-1/2 h-[560px] w-[560px] -translate-y-1/2 rounded-full bg-blue/10 blur-[120px]"></div>
    <div class="absolute -left-40 bottom-0 h-[420px] w-[420px] rounded-full bg-blue-bright/10 blur-[110px]"></div>
    <div class="absolute right-[8%] top-1/2 hidden h-[460px] w-[460px] -translate-y-1/2 rounded-full border border-blue/15 lg:block"></div>
    <div class="absolute right-[12%] top-1/2 hidden h-[340px] w-[340px] -translate-y-1/2 rotate-[-12deg] rounded-full border border-blue/20 lg:block"></div>
    <div class="absolute right-[16%] top-1/2 hidden h-[220px] w-[220px] -translate-y-1/2 rotate-[20deg] rounded-full border border-blue/25 lg:block"></div>
  </div>

  <ParticlesCanvas client:idle />

  <div class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-12 px-6 py-20 lg:grid-cols-2">
    <div>
      <h1 class="font-display text-4xl font-bold leading-[1.08] tracking-tight text-navy sm:text-5xl lg:text-6xl">
        Transformamos ideas en <span class="bg-gradient-to-r from-blue to-blue-bright bg-clip-text text-transparent">soluciones tecnológicas</span> que impulsan tu empresa.
      </h1>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-navy/70 lg:text-xl">
        Desarrollamos software a medida, plataformas virtuales, sitios informativos, telecomunicaciones y ciberseguridad para que tu negocio crezca con tecnología confiable.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <Button href="/contacto" class="px-8 py-4 text-base">Solicita una cotización</Button>
        <Button href="/servicios" variant="outline" class="px-8 py-4 text-base">Conoce nuestros servicios</Button>
      </div>
    </div>

    <div class="relative mx-auto hidden h-[420px] w-full max-w-md items-center justify-center lg:flex" aria-hidden="true">
      <img src="/images/isotipo-transparent.png" alt="" width="240" height="214" class="relative z-10 h-auto w-56 drop-shadow-[0_0_40px_rgba(37,99,235,0.35)]" />
    </div>
  </div>

  <div class="absolute bottom-6 left-1/2 z-10 -translate-x-1/2 text-navy/30" aria-hidden="true">
    <Icon name="chevron-down" size={24} />
  </div>
</section>
