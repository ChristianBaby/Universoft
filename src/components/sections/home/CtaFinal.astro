---
import Button from "@/components/ui/Button.astro";
import GradientBlob from "@/components/ui/GradientBlob.astro";
---

<section class="relative overflow-hidden bg-gradient-to-br from-navy via-navy-deep to-blue-dark py-24">
  <GradientBlob color="blue" size="lg" class="-top-40 -left-20 opacity-30" />
  <GradientBlob color="blue-bright" size="md" class="-bottom-20 -right-20 opacity-20" />
  <div class="relative z-10 mx-auto max-w-3xl px-6 text-center reveal">
    <h2 class="font-display text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-5xl">
      ¿Listo para llevar tu empresa al siguiente nivel?
    </h2>
    <p class="mt-4 text-base leading-relaxed text-white/70 lg:text-lg">
      Cuéntanos tu proyecto y te damos una propuesta sin compromiso. Estamos listos para ayudarte.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <Button href="/contacto" class="px-8 py-4 text-base">Solicita una cotización</Button>
      <Button href="/servicios" variant="outline" class="border-white/30 px-8 py-4 text-base text-white hover:bg-white/10">Ver servicios</Button>
    </div>
  </div>
</section>
