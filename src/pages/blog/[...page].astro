---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import PostCard from "@/components/blog/PostCard.astro";
import Pagination from "@/components/blog/Pagination.astro";
import Icon from "@/components/ui/Icon.astro";
import { getPublishedPosts } from "@/lib/blog";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: 9 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const isFirstPage = page.currentPage === 1;
const path = isFirstPage ? "/blog" : `/blog/${page.currentPage}`;
const title = isFirstPage
  ? "Blog de tecnología, software y ciberseguridad"
  : `Blog de tecnología, software y ciberseguridad — Página ${page.currentPage}`;
const description = isFirstPage
  ? "Artículos sobre desarrollo de software, ciberseguridad, telecomunicaciones y tendencias tecnológicas para empresas en Perú."
  : `Página ${page.currentPage} de artículos sobre desarrollo de software, ciberseguridad, telecomunicaciones y tendencias tecnológicas para empresas en Perú.`;
---

<BaseLayout title={title} description={description} path={path}>
  <main>
    <section class="bg-white pb-16 pt-32">
      <div class="mx-auto max-w-7xl px-6">
        <SectionHeader
          as="h1"
          label="Blog"
          title="Ideas y conocimiento para tu empresa"
          description="Artículos sobre tecnología, software y buenas prácticas para ayudarte a tomar mejores decisiones."
          centered={false}
        />
        <div class="reveal mt-8 max-w-xl">
          <div class="relative">
            <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-navy/40">
              <Icon name="search" size={18} />
            </span>
            <input
              id="blog-search-input"
              type="text"
              placeholder="Buscar artículos del blog..."
              autocomplete="off"
              class="w-full rounded-full border border-navy/15 bg-white py-3 pl-11 pr-4 text-sm text-navy placeholder:text-navy/40 focus:border-blue focus:outline-none focus:ring-2 focus:ring-blue/15"
            />
          </div>
          <ul id="blog-search-results" class="mt-3 hidden flex-col gap-2"></ul>
          <p id="blog-search-empty" class="mt-3 hidden text-sm text-navy/50">No encontramos artículos con ese término.</p>
        </div>
      </div>
    </section>

    <section class="bg-cream py-24">
      <div class="mx-auto max-w-7xl px-6">
        <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {page.data.map((post, i) => (
            <li class="reveal" style={`transition-delay:${(i % 3) * 80}ms`}>
              <PostCard post={post} />
            </li>
          ))}
        </ul>

        <Pagination currentPage={page.currentPage} lastPage={page.lastPage} baseUrl="/blog" />
      </div>
    </section>
  </main>

  <script is:inline type="module">
    const input = document.getElementById("blog-search-input");
    const resultsEl = document.getElementById("blog-search-results");
    const emptyEl = document.getElementById("blog-search-empty");

    if (input && resultsEl && emptyEl) {
      let pagefind = null;
      let debounceId;

      const runSearch = async (term) => {
        if (!term) {
          resultsEl.classList.add("hidden");
          resultsEl.innerHTML = "";
          emptyEl.classList.add("hidden");
          return;
        }
        if (!pagefind) {
          pagefind = await import("/pagefind/pagefind.js");
        }
        const search = await pagefind.search(term, { filters: { section: ["blog"] } });
        const items = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));

        if (items.length === 0) {
          resultsEl.classList.add("hidden");
          resultsEl.innerHTML = "";
          emptyEl.classList.remove("hidden");
          return;
        }

        emptyEl.classList.add("hidden");
        resultsEl.classList.remove("hidden");
        resultsEl.classList.add("flex");
        resultsEl.innerHTML = items
          .map(
            (item) => `
              <li>
                <a href="${item.url}" class="block rounded-xl border border-navy/10 bg-white p-4 transition-colors hover:border-blue/30 hover:shadow-sm">
                  <p class="font-display text-sm font-semibold text-navy">${item.meta?.title ?? "Artículo"}</p>
                  <p class="mt-1 text-xs leading-relaxed text-navy/60">${item.excerpt}</p>
                </a>
              </li>
            `
          )
          .join("");
      };

      input.addEventListener("input", () => {
        clearTimeout(debounceId);
        const term = input.value.trim();
        debounceId = setTimeout(() => runSearch(term), 200);
      });
    }
  </script>
</BaseLayout>
