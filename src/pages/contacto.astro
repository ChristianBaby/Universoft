---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import Icon from "@/components/ui/Icon.astro";
import ContactForm from "@/components/sections/contact/ContactForm.tsx";
import { CONTACT } from "@/lib/constants/contact";
---

<BaseLayout
  title="Contacto y cotización de software"
  description="Cuéntanos tu proyecto y te enviaremos una propuesta personalizada sin compromiso. Escríbenos por WhatsApp o llena el formulario."
  path="/contacto"
>
  <main>
    <section class="bg-white pb-16 pt-32">
      <div class="mx-auto max-w-7xl px-6">
        <SectionHeader
          as="h1"
          label="Contacto"
          title="Cuéntanos tu proyecto"
          description="Te enviaremos una propuesta a tu medida, sin compromiso. Respondemos en menos de 24 horas."
          centered={false}
        />
      </div>
    </section>

    <section class="bg-cream py-24">
      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-16 px-6 lg:grid-cols-2">
        <div class="reveal flex flex-col gap-8">
          <h2 class="font-display text-2xl font-bold text-navy">Información de contacto</h2>
          <ul class="flex flex-col gap-4">
            <li>
              <a href={CONTACT.whatsapp} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 rounded-2xl border border-navy/10 bg-white p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-blue/30 hover:shadow-lg">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-green-600 text-white"><Icon name="message-circle" size={20} /></span>
                <span><span class="block text-xs font-semibold text-navy/50">WhatsApp</span><span class="text-sm font-medium text-navy">+51 {CONTACT.phone}</span></span>
              </a>
            </li>
            <li>
              <a href={`tel:+51${CONTACT.phone}`} class="flex items-center gap-4 rounded-2xl border border-navy/10 bg-white p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-blue/30 hover:shadow-lg">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-blue to-blue-bright text-white"><Icon name="phone" size={20} /></span>
                <span><span class="block text-xs font-semibold text-navy/50">Teléfono</span><span class="text-sm font-medium text-navy">{CONTACT.phone}</span></span>
              </a>
            </li>
            <li>
              <a href={`mailto:${CONTACT.email}`} class="flex items-center gap-4 rounded-2xl border border-navy/10 bg-white p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-blue/30 hover:shadow-lg">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-blue to-blue-bright text-white"><Icon name="mail" size={20} /></span>
                <span><span class="block text-xs font-semibold text-navy/50">Correo</span><span class="text-sm font-medium text-navy">{CONTACT.email}</span></span>
              </a>
            </li>
            <li class="flex items-center gap-4 rounded-2xl border border-navy/10 bg-white p-5 shadow-sm">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-blue to-blue-bright text-white"><Icon name="map-pin" size={20} /></span>
              <span><span class="block text-xs font-semibold text-navy/50">Ubicación</span><span class="text-sm font-medium text-navy">{CONTACT.location}</span></span>
            </li>
          </ul>
        </div>

        <div class="reveal relative rounded-3xl border border-navy/10 bg-white p-8 shadow-lg">
          <h2 class="font-display mb-6 text-2xl font-bold text-navy">Envíanos un mensaje</h2>
          <ContactForm client:load />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
