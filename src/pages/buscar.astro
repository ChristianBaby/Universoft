---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Buscar en el sitio"
  description="Busca artículos, servicios e información de Universoft Systems."
  path="/buscar"
  noindex
>
  <main class="mx-auto max-w-3xl px-6 pb-24 pt-32">
    <h1 class="font-display text-3xl font-bold text-navy sm:text-4xl">Buscar</h1>
    <p class="mt-3 text-navy/60">Encuentra servicios, artículos y respuestas en todo el sitio.</p>
    <div id="search" class="mt-10"></div>
  </main>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      if (window.PagefindUI) {
        new window.PagefindUI({ element: "#search", showSubResults: true, showImages: false, language: "es" });
      }
    });
  </script>
</BaseLayout>
