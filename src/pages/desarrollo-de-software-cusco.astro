---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { PROJECT_CASES } from "@/lib/constants/cases";
import { SITE_URL } from "@/lib/constants/site";
import { faqPageJsonLd, breadcrumbJsonLd } from "@/lib/seo/structuredData";

const faq = [
  {
    question: "¿Qué empresa de desarrollo de software a medida hay en Cusco?",
    answer: "Universoft Systems desarrolla software a medida desde Cusco para empresas de Perú y Latinoamérica: plataformas web, sistemas de gestión, tiendas online y automatización con inteligencia artificial.",
  },
  {
    question: "¿Cuánto cuesta desarrollar software a medida en Cusco?",
    answer: "El costo depende del alcance, las integraciones y el número de usuarios. Cada proyecto se cotiza a medida, y la inversión inicial de nuestros servicios web empieza desde S/ 250 en paquetes de lanzamiento.",
  },
  {
    question: "¿Atienden clientes fuera de Cusco?",
    answer: "Sí. Trabajamos de forma remota con empresas de todo Perú y de otros países de Latinoamérica, con reuniones virtuales y entregas por etapas.",
  },
  {
    question: "¿Qué horario de atención tienen?",
    answer: "Lunes a viernes de 8:00 a 18:00 y sábados de 8:00 a 13:00, hora de Perú.",
  },
];

const jsonLd = [
  faqPageJsonLd(faq),
  breadcrumbJsonLd([
    { name: "Inicio", url: SITE_URL },
    { name: "Desarrollo de software en Cusco", url: `${SITE_URL}/desarrollo-de-software-cusco` },
  ]),
];
---

<BaseLayout
  title="Desarrollo de software en Cusco"
  description="Software y plataformas a medida desarrollados en Cusco para empresas de Perú y Latinoamérica. Conoce cómo trabajamos y pide una propuesta sin compromiso."
  path="/desarrollo-de-software-cusco"
  jsonLd={jsonLd}
>
  <main>
    <section class="bg-white pb-16 pt-32">
      <div class="mx-auto max-w-4xl px-6">
        <SectionHeader
          as="h1"
          label="Cusco, Perú"
          title="Desarrollo de software a medida en Cusco"
          description="Diseñamos y desarrollamos plataformas web, sistemas de gestión y tiendas online para empresas que necesitan una solución hecha para sus procesos."
          centered={false}
        />
        <p class="mt-6 text-base font-medium leading-relaxed text-navy">
          Universoft Systems es una empresa de desarrollo de software con sede en Cusco. Creamos sistemas a medida para empresas de Perú y Latinoamérica, con un proceso que incluye análisis de procesos, diseño, desarrollo, pruebas y soporte después de la entrega.
        </p>
        <div class="mt-8">
          <Button href="/contacto?servicio=plataformas" class="px-8 py-4 text-base">Solicitar propuesta</Button>
        </div>
      </div>
    </section>

    <section class="bg-cream py-24">
      <div class="mx-auto max-w-6xl px-6">
        <SectionHeader label="Casos" title="Proyectos reales en producción" description="Sistemas desarrollados por Universoft Systems que hoy están en línea." />
        <ul class="mt-16 grid grid-cols-1 gap-6 lg:grid-cols-3">
          {PROJECT_CASES.map((project) => (
            <li class="rounded-2xl border border-navy/10 bg-white p-8">
              <span class="text-xs font-semibold uppercase tracking-widest text-blue">{project.category}</span>
              <h2 class="font-display mt-3 text-xl font-bold text-navy">{project.name}</h2>
              <p class="mt-3 text-sm leading-relaxed text-navy/70">{project.summary}</p>
              <a href={project.url} target="_blank" rel="noopener" class="mt-4 inline-block text-sm font-semibold text-blue hover:underline">Visitar sitio</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bg-white py-24">
      <div class="mx-auto max-w-3xl px-6">
        <SectionHeader label="Preguntas frecuentes" title="Lo que más nos preguntan" centered={false} />
        <div class="mt-12 flex flex-col gap-4">
          {faq.map((item) => (
            <details class="group rounded-2xl border border-navy/10 bg-white shadow-sm">
              <summary class="cursor-pointer list-none px-6 py-5 text-sm font-semibold text-navy [&::-webkit-details-marker]:hidden">{item.question}</summary>
              <div class="px-6 pb-5">
                <p class="text-sm leading-relaxed text-navy/70">{item.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
