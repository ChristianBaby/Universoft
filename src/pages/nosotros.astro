---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import Icon from "@/components/ui/Icon.astro";
import CtaFinal from "@/components/sections/home/CtaFinal.astro";

const values = [
  "Compromiso con resultados",
  "Calidad y mejora continua",
  "Transparencia",
  "Innovación",
  "Seguridad y responsabilidad con la información",
];

const cards = [
  {
    icon: "target",
    title: "Misión",
    content:
      "Impulsar el crecimiento de las empresas mediante soluciones de software confiables, seguras y a la medida de sus necesidades.",
  },
  {
    icon: "eye",
    title: "Visión",
    content:
      "Ser una empresa de tecnología reconocida por la calidad, innovación y cercanía con la que transformamos las ideas de nuestros clientes en realidades digitales.",
  },
];
---

<BaseLayout
  title="Nosotros, equipo y misión de Universoft Systems"
  description="Conoce a Universoft Systems: nuestra misión, visión, valores y el equipo detrás de cada proyecto de software en Cusco, Perú."
  path="/nosotros"
>
  <main>
    <section class="bg-white pb-16 pt-32">
      <div class="mx-auto max-w-7xl px-6">
        <SectionHeader
          as="h1"
          label="Sobre nosotros"
          title="Equipo comprometido con tu éxito"
          description="Conoce a las personas detrás de Universoft Systems y los principios que guían nuestro trabajo."
          centered={false}
        />
      </div>
    </section>

    <section class="bg-white pb-24">
      <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-16 px-6 lg:grid-cols-2">
        <div class="reveal">
          <h2 class="font-display text-3xl font-bold text-navy sm:text-4xl">Una empresa comprometida con tu transformación digital</h2>
          <p class="mt-6 text-base leading-relaxed text-navy/70 lg:text-lg">
            Universoft Systems es una empresa de desarrollo de software comprometida con crear soluciones tecnológicas que generen valor real. Combinamos talento técnico, creatividad y un trato cercano para acompañar a cada empresa en su transformación digital.
          </p>
        </div>
        <figure class="reveal relative overflow-hidden rounded-3xl">
          <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=800&h=600&fit=crop&q=80" alt="Equipo de trabajo tecnológico" width="800" height="600" loading="lazy" decoding="async" class="h-full w-full rounded-3xl object-cover" />
          <figcaption class="absolute inset-x-4 bottom-4 rounded-2xl bg-navy/85 p-6 backdrop-blur">
            <p class="text-sm italic leading-relaxed text-white/85">
              “Nuestro objetivo es que la tecnología no sea un obstáculo, sino el puente que lleva tu empresa al futuro.”
            </p>
            <p class="mt-2 text-xs font-semibold text-blue-bright">— Equipo Universoft Systems</p>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="bg-cream py-24">
      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-6 md:grid-cols-3">
        {cards.map((card) => (
          <article class="reveal flex flex-col gap-4 rounded-2xl border border-navy/10 bg-white p-8 shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-blue to-blue-bright text-white shadow-md shadow-blue/20">
              <Icon name={card.icon} size={22} />
            </div>
            <h2 class="font-display text-lg font-bold text-navy">{card.title}</h2>
            <p class="text-sm leading-relaxed text-navy/60">{card.content}</p>
          </article>
        ))}
        <article class="reveal flex flex-col gap-4 rounded-2xl border border-navy/10 bg-white p-8 shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-blue to-blue-bright text-white shadow-md shadow-blue/20">
            <Icon name="heart" size={22} />
          </div>
          <h2 class="font-display text-lg font-bold text-navy">Valores</h2>
          <ul class="flex flex-col gap-2">
            {values.map((value) => (
              <li class="flex items-center gap-2 text-sm text-navy/60">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-gradient-to-r from-blue to-blue-bright"></span>
                {value}
              </li>
            ))}
          </ul>
        </article>
      </div>
    </section>

    <CtaFinal />
  </main>
</BaseLayout>
