---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/home/Hero.astro";
import ValueProposition from "@/components/sections/home/ValueProposition.astro";
import CasesSection from "@/components/sections/home/CasesSection.astro";
import ServicesSummary from "@/components/sections/home/ServicesSummary.astro";
import TechStack from "@/components/sections/home/TechStack.astro";
import WhyUs from "@/components/sections/home/WhyUs.astro";
import CtaFinal from "@/components/sections/home/CtaFinal.astro";
---

<BaseLayout
  title="Software y páginas web en Cusco, Perú"
  description="Creamos tu página web o sistema a medida para que tu negocio aparezca en Google desde el primer día. Trabajamos con empresas de Perú y Latinoamérica."
  path="/"
>
  <main>
    <Hero />
    <ValueProposition />
    <CasesSection />
    <ServicesSummary />
    <TechStack />
    <WhyUs />
    <CtaFinal />
  </main>
</BaseLayout>
